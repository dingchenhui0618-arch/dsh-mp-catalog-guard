{
  "name": "dsh-mp-catalog-guard",
  "version": "0.1.0",
  "engines": { "dsh": ">=0.2.1-rc.2 <0.3.0" },
  "description": "WeChat mini-program content catalog guard: integer amountFen, money()-only rendering, required fields, duplicate copy and image paths — a report plus an applyable unified diff (dry-run by default).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "mp-catalog-guard": "./bin/catalog-guard.mjs"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "demo": "node scripts/demo.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "miniprogram",
    "wechat",
    "catalog",
    "price",
    "lint"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dingchenhui0618-arch/dsh-mp-catalog-guard.git"
  },
  "homepage": "https://github.com/dingchenhui0618-arch/dsh-mp-catalog-guard#readme",
  "bugs": {
    "url": "https://github.com/dingchenhui0618-arch/dsh-mp-catalog-guard/issues"
  },
  "license": "MIT"
}
